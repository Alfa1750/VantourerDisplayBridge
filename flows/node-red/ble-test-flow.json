        "func": "let teller = context.get(\"teller\") || 0;\nteller++;\ncontext.set(\"teller\", teller);\n\nmsg.payload = {\n    test: \"VictronDisplay\",\n    teller: teller,\n    spanning: 13.4,\n    stroom: -2.5,\n    soc: 85\n};\n\nreturn msg;",
