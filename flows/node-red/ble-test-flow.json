    {
        "id": "b294ba7c7f327669",
        "type": "function",
        "z": "testflow036",
        "name": "gebruik actieve TCP-client",
        "func": "const topic = flow.get(\"tcpClientTopic\");\n\nif (!topic) {\n    node.warn(\"Geen actieve TCP-client gevonden\");\n    return null;\n}\n\nif (typeof msg.payload !== \"string\") {\n    msg.payload = JSON.stringify(msg.payload);\n}\nif (!msg.payload.endsWith(\"\\n\")) {\n    msg.payload += \"\\n\";\n}\n\nmsg.topic = topic;\nmsg.action = \"write\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 170,
        "y": 360,
        "wires": [
