#!/bin/bash

# Load the installed SetupHelper v9.7 functions.
# Do not vendor or copy SetupHelper into this package.
source "/data/SetupHelper/HelperResources/IncludeHelpers"

# PackageManager uses "check" to query package status without changing it.
if [ "$scriptAction" == "CHECK" ] || [ "$scriptAction" == "EXIT" ]; then
    exit $EXIT_SUCCESS
fi

# Keep the standard SetupHelper install/uninstall choices, but perform
# project-specific prerequisite checks before installing the service.
if [ "$scriptAction" == "NONE" ]; then
    standardActionPrompt
fi

if [ "$scriptAction" == "INSTALL" ]; then

    # No package changes have been made yet. Keep failures in this preflight
    # phase from triggering SetupHelper's automatic uninstall of an old version.
    installPreChecks=true

    if ! command -v python3 >/dev/null 2>&1; then
        setInstallFailed $EXIT_ERROR "Python 3 is required but python3 was not found."
    fi

    if ! $installFailed && ! command -v multilog >/dev/null 2>&1; then
        setInstallFailed $EXIT_ERROR "The multilog executable is required but was not found."
    fi

    if ! $installFailed; then
        if ! python3 - <<'PY'
import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib

bus = dbus.SystemBus()
if not bus.name_has_owner("org.bluez"):
    raise RuntimeError("The system D-Bus name org.bluez is not available")

manager = dbus.Interface(
    bus.get_object("org.bluez", "/"),
    "org.freedesktop.DBus.ObjectManager"
)
objects = manager.GetManagedObjects()
adapter_path = None
for path, interfaces in objects.items():
    if (
        "org.bluez.GattManager1" in interfaces
        and "org.bluez.LEAdvertisingManager1" in interfaces
        and "org.bluez.Adapter1" in interfaces
    ):
        adapter_path = path
        break

if adapter_path is None:
    raise RuntimeError("No Bluetooth adapter exposes GATT, LE advertising, and Adapter1")

properties = dbus.Interface(
    bus.get_object("org.bluez", adapter_path),
    "org.freedesktop.DBus.Properties"
)
if not bool(properties.Get("org.bluez.Adapter1", "Powered")):
    raise RuntimeError("The Bluetooth adapter is not powered on")
PY
        then
            setInstallFailed $EXIT_ERROR "BLE prerequisites failed: Python D-Bus/GLib bindings, BlueZ system D-Bus, or a compatible BLE adapter are unavailable."
        fi
    fi

    # The reference Pi needed vesmart-server stopped for reliable ESP32
    # discovery. Report its state, but never stop or disable it automatically.
    if ! $installFailed && command -v svstat >/dev/null 2>&1; then
        vesmart_status="$(svstat /service/vesmart-server 2>/dev/null || true)"
        if printf '%s\n' "$vesmart_status" | grep -Eq '(^|: )up([[:space:]]|$)'; then
            logMessage "WARNING: vesmart-server is running. On the development Pi this interfered with ESP32 BLE discovery. This installer will not stop or disable it; validate the effect on this Venus OS version."
        fi
    fi

    # From this point onward SetupHelper may modify service state. Failures
    # during installation must therefore trigger its normal rollback path.
    if ! $installFailed; then
        installPreChecks=false
    fi
fi

# SetupHelper v9.7 installs and tracks the service directory automatically.
# On uninstall, endScript also removes the installed service.
endScript 'INSTALL_SERVICES'
